cabal-version: 3.0
name:          state
version:       0.2.0
synopsis:
  The kernel of the agent flows: typed steps, the run log and its advice

build-type:    Simple

-- Copied from Ivy-Apps/haskell-template's `shared-properties`, minus relude and
-- its Prelude mixin: base's Prelude keeps the dependency set small.
common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  build-depends:      base >=4.18 && <5

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Data.Entity.Blob
    Data.Entity.Event
    Data.Entity.Run
    Data.Field
    Data.Json
    Data.Payload.Blob
    Data.Payload.Event
    Data.Payload.Upcast
    Data.Projection
    Data.Projection.Column
    Data.Projection.Context
    Data.Projection.Gaps
    Data.Projection.Questions
    Data.Projection.Registry
    Data.Projection.Runs
    Data.Projection.Spans
    Data.Projection.Tasks
    Data.Projection.Views
    Data.Report
    Data.Tsv
    Effects.Clock
    Effects.Console
    Effects.Environment
    Effects.FileSystem
    Effects.Gh
    Effects.Git
    Effects.Log
    Effects.Random
    Effects.Store.Connection
    Effects.Store.EventRows
    Effects.Store.Events
    Effects.Store.Migration
    Effects.Store.Projection
    Effects.Store.Report
    Effects.Store.Sql
    State.Artifact
    State.Category.Effect
    State.Category.Flow
    State.Category.Fuel
    State.Category.Graph
    State.Category.Meter
    State.Category.Path
    State.Category.Step
    State.Category.Ty
    State.Cli.Command
    State.Cli.Query
    State.Cli.Render
    State.Cli.Render.Mermaid
    State.Cli.Resume
    State.Cli.Route
    State.Cli.Shell
    State.Cli.View
    State.Flow.Block
    State.Flow.Combinator
    State.Flow.Role.Architect
    State.Flow.Role.Chief
    State.Flow.Role.Engineer
    State.Flow.Role.TenX
    State.FlowName
    State.Protocol.Advice
    State.Protocol.Binding
    State.Protocol.Handback
    State.Protocol.Hook
    State.Protocol.Record
    State.Role
    State.Run.Ask
    State.Run.Card
    State.Run.Codec
    State.Run.Epic
    State.Run.Event
    State.Run.Fan
    State.Run.Fold
    State.Run.Gap
    State.Run.Id
    State.Run.IJson
    State.Run.Stopgap
    State.Show
    State.Step.Artifact
    State.Step.Build
    State.Step.Catalog
    State.Step.Fan
    State.Step.Fuel
    State.Step.Gather
    State.Step.Pick
    State.Step.Plan
    State.Step.Request
    State.Step.Review
    State.Step.Ship
    State.Step.Ticket
    State.Table

  other-modules:   Paths_state
  autogen-modules: Paths_state
  build-depends:
    , aeson
    , bytestring
    , containers
    , cryptohash-sha256
    , direct-sqlite
    , directory
    , effectful
    , filepath
    , network-uri
    , optparse-applicative
    , process
    , scientific
    , sqlite-simple
    , text
    , time
    , unix

executable state
  import:         shared-properties
  hs-source-dirs: app/state
  main-is:        Main.hs
  build-depends:  state

executable state-hook
  import:         shared-properties
  hs-source-dirs: app/state-hook
  main-is:        Main.hs
  build-depends:  state

test-suite state-test
  import:             shared-properties
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-tool-depends: hspec-discover:hspec-discover

  -- Threaded: the run store's spec runs two writers at once, and one waiting
  -- on SQLite's lock must not stop the other.
  ghc-options:        -threaded
  other-modules:
    Concurrently
    Data.FieldSpec
    Data.Payload.EventSpec
    Data.Payload.Fixtures
    Data.ReportSpec
    Data.TsvSpec
    Doubles.Clock
    Doubles.Console
    Doubles.Environment
    Doubles.FileSystem
    Doubles.Gh
    Doubles.Git
    Doubles.Log
    Doubles.Random
    Effects.FileSystemSpec
    Effects.LogSpec
    Effects.RandomSpec
    Effects.Store.Fixtures
    Effects.Store.MigrationSpec
    Effects.Store.Projected
    Effects.Store.ProjectionSpec
    Effects.Store.ReadSpec
    SpecHook
    State.ArchitectureSpec
    State.ArtifactSpec
    State.Category.FlowGen
    State.Category.FlowSpec
    State.Category.FuelSpec
    State.Category.GraphSpec
    State.Category.LawsSpec
    State.Category.PathSpec
    State.Cli.CodeSpec
    State.Cli.CommandSpec
    State.Cli.QuerySpec
    State.Cli.Render.MermaidSpec
    State.Cli.RenderSpec
    State.Cli.ResumeSpec
    State.Cli.RouteSpec
    State.Cli.Shell.ContextSpec
    State.Cli.Shell.FocusSpec
    State.Cli.Shell.HookSpec
    State.Cli.Shell.MainSpec
    State.Cli.Shell.World
    State.Cli.ShellSpec
    State.Cli.ViewSpec
    State.E2ESpec
    State.Flow.Attend
    State.Flow.BlockSpec
    State.Flow.CombinatorSpec
    State.Flow.InlineSpec
    State.Flow.Role.ChiefSpec
    State.Flow.Role.EngineerSpec
    State.Flow.Role.TenXSpec
    State.Flow.Triage
    State.Golden
    State.Protocol.AdviceGoldenSpec
    State.Protocol.AdviceSpec
    State.Protocol.BindingSpec
    State.Protocol.HandbackSpec
    State.Protocol.HookSpec
    State.RoleSpec
    State.Run.AskSpec
    State.Run.CardSpec
    State.Run.CodecSpec
    State.Run.EpicSpec
    State.Run.EventGen
    State.Run.EventSpec
    State.Run.FanSpec
    State.Run.FoldSpec
    State.Run.GapSpec
    State.Run.IJsonSpec
    State.Run.RunGen
    State.Run.StopgapSpec
    State.TableSpec

  build-depends:
    , aeson
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , optparse-applicative
    , process
    , sqlite-simple
    , state
    , temporary
    , text
    , time
