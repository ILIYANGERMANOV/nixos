cabal-version: 3.0
name:          state
version:       0.1.0.0
synopsis:      The kernel of the agent flows: typed steps, the run log and its advice
build-type:    Simple

-- Copied from Ivy-Apps/haskell-template's `shared-properties`, minus relude and
-- its Prelude mixin: base's Prelude keeps the dependency set small.
common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  build-depends:      base >=4.18 && <5

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Effects.Clock
    Effects.Console
    Effects.Environment
    Effects.FileSystem
    Effects.Gh
    Effects.Git
    Effects.Log
    Effects.Random
    State.Advice
    State.Ask
    State.Cap
    State.Cli
    State.Codec
    State.Event
    State.Flow
    State.Flows.Blocks
    State.Flows.Engineer
    State.Flows.TenX
    State.Fold
    State.Graph
    State.Handback
    State.Hook
    State.Id
    State.Mode
    State.Path
    State.Render
    State.Render.Mermaid
    State.Shell
    State.Show
    State.Steps
    State.View

  build-depends:
    , aeson
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , process
    , text
    , time

executable state
  import:         shared-properties
  hs-source-dirs: app/state
  main-is:        Main.hs
  build-depends:
    , state
    , text

executable state-hook
  import:         shared-properties
  hs-source-dirs: app/state-hook
  main-is:        Main.hs
  build-depends:
    , state
    , text

test-suite state-test
  import:             shared-properties
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Doubles.Clock
    Doubles.Console
    Doubles.Environment
    Doubles.FileSystem
    Doubles.Gh
    Doubles.Git
    Doubles.Log
    Doubles.Random
    Effects.FileSystemSpec
    Effects.LogSpec
    Effects.RandomSpec
    State.AdviceSpec
    State.ArchitectureSpec
    State.AskSpec
    State.CliSpec
    State.CodecSpec
    State.E2ESpec
    State.EventGen
    State.EventSpec
    State.FlowGen
    State.Flows.BlocksSpec
    State.Flows.EngineerSpec
    State.Flows.TenXSpec
    State.FlowSpec
    State.FoldSpec
    State.Golden
    State.GraphSpec
    State.HandbackSpec
    State.HookSpec
    State.ModeSpec
    State.PathSpec
    State.Render.MermaidSpec
    State.RenderSpec
    State.RunGen
    State.Shell.HookSpec
    State.Shell.MainSpec
    State.Shell.World
    State.StepsSpec

  build-depends:
    , aeson
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , process
    , state
    , temporary
    , text
    , time
