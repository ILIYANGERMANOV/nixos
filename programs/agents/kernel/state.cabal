cabal-version: 3.0
name:          state
version:       0.1.0.0
synopsis:
  The kernel of the agent flows: typed steps, the run log and its advice

build-type:    Simple

-- Copied from Ivy-Apps/haskell-template's `shared-properties`, minus relude and
-- its Prelude mixin: base's Prelude keeps the dependency set small.
common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  build-depends:      base >=4.18 && <5

library
  import:          shared-properties
  hs-source-dirs:  src
  exposed-modules:
    Effects.Clock
    Effects.Console
    Effects.Environment
    Effects.FileSystem
    Effects.Gh
    Effects.Git
    Effects.Log
    Effects.Random
    Effects.Store
    State.Category.Effect
    State.Category.Flow
    State.Category.Fuel
    State.Category.Graph
    State.Category.Meter
    State.Category.Path
    State.Category.Step
    State.Category.Ty
    State.Cli.Command
    State.Cli.Render
    State.Cli.Render.Mermaid
    State.Cli.Route
    State.Cli.Shell
    State.Cli.View
    State.Flow.Architect
    State.Flow.Chief
    State.Flow.Drawn
    State.Flow.Engineer
    State.Flow.Library
    State.Flow.TenX
    State.FlowName
    State.Protocol.Advice
    State.Protocol.Binding
    State.Protocol.Handback
    State.Protocol.Hook
    State.Protocol.Record
    State.Role
    State.Run.Ask
    State.Run.Codec
    State.Run.Event
    State.Run.Fan
    State.Run.Fold
    State.Run.Id
    State.Show
    State.Step.Artifact
    State.Step.Build
    State.Step.Catalog
    State.Step.Fan
    State.Step.Fuel
    State.Step.Gather
    State.Step.Pick
    State.Step.Plan
    State.Step.Request
    State.Step.Review
    State.Step.Ship
    State.Step.Ticket
    State.Table

  build-depends:
    , aeson
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , optparse-applicative
    , process
    , sqlite-simple
    , text
    , time

executable state
  import:         shared-properties
  hs-source-dirs: app/state
  main-is:        Main.hs
  build-depends:
    , state
    , text

executable state-hook
  import:         shared-properties
  hs-source-dirs: app/state-hook
  main-is:        Main.hs
  build-depends:
    , state
    , text

test-suite state-test
  import:             shared-properties
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-tool-depends: hspec-discover:hspec-discover

  -- Threaded: the run store's spec runs two writers at once, and one waiting
  -- on SQLite's lock must not stop the other.
  ghc-options:        -threaded
  other-modules:
    Concurrently
    Doubles.Clock
    Doubles.Console
    Doubles.Environment
    Doubles.FileSystem
    Doubles.Gh
    Doubles.Git
    Doubles.Log
    Doubles.Random
    Effects.FileSystemSpec
    Effects.LogSpec
    Effects.RandomSpec
    SpecHook
    State.ArchitectureSpec
    State.Category.FlowGen
    State.Category.FlowSpec
    State.Category.FuelSpec
    State.Category.GraphSpec
    State.Category.LawsSpec
    State.Category.PathSpec
    State.Cli.CommandSpec
    State.Cli.Render.MermaidSpec
    State.Cli.RenderSpec
    State.Cli.RouteSpec
    State.Cli.Shell.HookSpec
    State.Cli.Shell.MainSpec
    State.Cli.Shell.World
    State.Cli.ViewSpec
    State.E2ESpec
    State.Flow.Attend
    State.Flow.ChiefSpec
    State.Flow.EngineerSpec
    State.Flow.InlineSpec
    State.Flow.LibrarySpec
    State.Flow.TenXSpec
    State.Flow.Triage
    State.Golden
    State.Protocol.AdviceGoldenSpec
    State.Protocol.AdviceSpec
    State.Protocol.BindingSpec
    State.Protocol.HandbackSpec
    State.Protocol.HookSpec
    State.RoleSpec
    State.Run.AskSpec
    State.Run.CodecSpec
    State.Run.EventGen
    State.Run.EventSpec
    State.Run.FanSpec
    State.Run.FoldSpec
    State.Run.RunGen
    State.TableSpec

  build-depends:
    , aeson
    , bytestring
    , containers
    , directory
    , effectful
    , filepath
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , optparse-applicative
    , process
    , sqlite-simple
    , state
    , temporary
    , text
    , time
